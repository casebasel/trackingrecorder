<Window x:Class="TrackingRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:TrackingRecorder.App"
        Title="TrackingRecorder" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{DynamicResource Fenster}" FontFamily="{StaticResource Sans}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">
    <!-- Familie Set-Apps (Gestalt wie Stage Ingest): Kopf 44 px, Blöcke mit Block-Kopf, unten die Aufnahme. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Kopf: Marke links, zwei Zahlen rechts -->
        <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Linie}" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel VerticalAlignment="Center" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Source="{StaticResource Logo}" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="TrackingRecorder" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="KopfVersion" Style="{StaticResource Zahl}" FontSize="12" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" Margin="10,1,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="KopfRate" Text="–" Style="{StaticResource Zahl}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                    <TextBlock Text=" Bilder/s" Style="{StaticResource Zweit}" FontSize="13" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Linie}" Margin="12,0"/>
                    <TextBlock x:Name="KopfGeraete" Text="–" Style="{StaticResource Zahl}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                    <TextBlock Text=" Geräte" Style="{StaticResource Zweit}" FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel x:Name="KopfStoerung" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,0">
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource Linie}" Margin="12,0"/>
                        <app:Zeichen Art="warn" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="KopfStoerungText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Hauptfläche -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Lage in einem Satz, Timecode als Tafel -->
            <Border Style="{StaticResource Block}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <app:Zeichen x:Name="LageZeichen" Art="unbekannt" Width="18" Height="18" VerticalAlignment="Center" Margin="0,2,10,0"/>
                            <TextBlock x:Name="LageText" Text="Verbinde mit Mars …" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="LageMeta" Style="{StaticResource Zweit}" FontSize="13" Margin="28,6,0,0" Text="" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="Timecode Mars" Style="{StaticResource Leise}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TcText" Text="--:--:--:--" FontFamily="{StaticResource Mono}" FontSize="44" FontWeight="Medium"
                                   HorizontalAlignment="Right" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Geräte | Mars + Ereignisse -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Block}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource BlockKopf}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Geräte" Style="{StaticResource BlockTitel}"/>
                                    <TextBlock x:Name="GeraeteZahl" Text="" Style="{StaticResource Leise}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="AchsenKopf" Grid.Column="2" Style="{StaticResource Zahl}" Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Style="{StaticResource Leise}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Lage der Station"/>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DeviceList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Zeile}" Height="46">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <app:Zeichen Art="{Binding Art}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" ToolTip="{Binding State}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource Leise}">
                                                        <Run Text="{Binding State, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Serial, Mode=OneWay}" FontFamily="{StaticResource Mono}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Position}" Style="{StaticResource Zahl}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Info}" Style="{StaticResource Zahl}" Foreground="{Binding InfoBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Mars: Zustand aus der Web-Schnittstelle (Port 7008), Stage und Ablage -->
                    <Border Style="{StaticResource Block}">
                        <StackPanel>
                            <Border Style="{StaticResource BlockKopf}">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mars" Style="{StaticResource BlockTitel}"/>
                                    <TextBlock x:Name="MarsWebHinweis" Style="{StaticResource Leise}" Margin="8,0,0,0" VerticalAlignment="Center" Text="lese Zustand …"/>
                                </DockPanel>
                            </Border>
                            <ItemsControl x:Name="MarsList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Zeile}" Height="32">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <app:Zeichen Art="{Binding Art}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Zahl}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                           Foreground="{Binding ValueBrush}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Block}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource BlockKopf}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Ereignisse" Style="{StaticResource BlockTitel}"/>
                                    <TextBlock x:Name="EreignisZahl" Text="0" Style="{StaticResource Leise}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <TextBlock x:Name="EreignisLeer" Style="{StaticResource Leise}" Margin="14,12,14,0" TextWrapping="Wrap"
                                           Text="Keine. Fehlende Bilder, Sprünge und Kartensprünge erscheinen hier mit Timecode."/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="EventList" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Zeile}" Padding="14,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <app:Zeichen Art="warn" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Tc}" Style="{StaticResource Zahl}" Foreground="{DynamicResource Text3}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Aufnahme -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Linie}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="240" MaxWidth="420"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Take" Style="{StaticResource Zweit}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <!-- Stage-Namen sind lang (PROJEKT_Einstellung_Tnn): Feld wächst mit, voller Name im Tooltip (stage-system 24.11.) -->
                    <TextBox x:Name="TakeBox" Text="Take_001" FontWeight="SemiBold"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Speicherort" Style="{StaticResource Zweit}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="Ordner wählen" Margin="8,0,0,0" Click="OnPickFolder"/>
                        <TextBox x:Name="FolderBox" FontFamily="{StaticResource Mono}" FontSize="12"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <CheckBox x:Name="KlappeBox" Content="Mit der Klappe aufnehmen" IsChecked="True" HorizontalAlignment="Right"
                              Margin="0,0,0,8" Checked="OnKlappeChanged" Unchecked="OnKlappeChanged"
                              ToolTip="REC und Cut an der Stage (iOS-Klappe oder Kamera) starten und stoppen die Aufnahme. Take-Name und Take-ID kommen von der Stage."/>
                    <TextBlock x:Name="TakeStatus" Text=" " Style="{StaticResource Zahl}" Foreground="{DynamicResource Text2}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                    <!-- Starten: tippen. Stoppen: 0,6 s halten (Maus oder Leertaste/Enter), Füllung von links. -->
                    <Button x:Name="RecButton" Style="{StaticResource Haupt}" MinWidth="220" Click="OnRec"
                            PreviewMouseLeftButtonDown="OnRecDown" PreviewMouseLeftButtonUp="OnRecUp" MouseLeave="OnRecLeave"
                            PreviewKeyDown="OnRecKeyDown" PreviewKeyUp="OnRecKeyUp">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{DynamicResource AufAkzent}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="RecText" Text="Aufnahme starten" Foreground="{DynamicResource AufAkzent}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statusleiste -->
        <Border Grid.Row="3" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Linie}" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Leise}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="UpdateButton" Content="Neu starten" Height="22" FontSize="12" Padding="8,0" Margin="0,0,10,0"
                            Visibility="Collapsed" Click="OnUpdateRestart" ToolTip="Spielt das Update ein und startet die App neu."/>
                    <TextBlock x:Name="Version" Style="{StaticResource Zahl}" Foreground="{DynamicResource Text3}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mars" Style="{StaticResource Leise}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="IpBox" Width="120" Height="22" FontFamily="{StaticResource Mono}" FontSize="12"/>
                    <Button x:Name="ReconnectButton" Content="Neu verbinden" Height="22" FontSize="12" Padding="8,0" Margin="6,0,0,0" Click="OnReconnect"/>
                    <TextBlock x:Name="PortText" Style="{StaticResource Leise}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
