<Window x:Class="TrackingRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackingRecorder" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{DynamicResource Grund}" FontFamily="{StaticResource Sans}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Titel links, zwei Zahlen rechts -->
        <Border Background="{DynamicResource Kopf}" Padding="20,0">
            <DockPanel VerticalAlignment="Center" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="TrackingRecorder" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource KopfText}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="KopfRate" Text="–" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource KopfText}"/>
                    <TextBlock Text=" Bilder/s · " FontSize="14" Foreground="{DynamicResource KopfText2}"/>
                    <TextBlock x:Name="KopfGeraete" Text="–" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource KopfText}"/>
                    <TextBlock Text=" Geräte" FontSize="14" Foreground="{DynamicResource KopfText2}"/>
                    <StackPanel x:Name="KopfStoerung" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnAufKopf}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock x:Name="KopfStoerungText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource KopfText}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Hauptfläche -->
        <Grid Grid.Row="1" Margin="20,18,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Lage in einem Satz, Timecode als Tafel -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LageLampe" Width="12" Height="12" StrokeThickness="2" VerticalAlignment="Center" Margin="0,2,10,0"/>
                        <TextBlock x:Name="LageText" Text="Verbinde mit Mars …" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock x:Name="LageMeta" Style="{StaticResource Zweit}" FontSize="13" Margin="22,6,0,0" Text=""/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Timecode Mars" Style="{StaticResource Zweit}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TcText" Text="--:--:--:--" FontFamily="{StaticResource Mono}" FontSize="44" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,-2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Geräte | Ereignisse -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Geräte" Style="{StaticResource Gruppe}"/>
                        <TextBlock x:Name="GeraeteZahl" Text="" Style="{StaticResource Zweit}" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AchsenKopf" Grid.Column="1" Style="{StaticResource Zahl}" Foreground="{DynamicResource Text2}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Zweit}" HorizontalAlignment="Right" Text="Lage der Station"/>
                    </Grid>
                    <Border BorderBrush="{DynamicResource Linie}" BorderThickness="0,1,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DeviceList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LinieFein}" BorderThickness="0,0,0,1" Height="44">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{Binding LampFill}" Stroke="{Binding LampStroke}"
                                                         StrokeThickness="1.75" VerticalAlignment="Top" Margin="0,4,0,0" ToolTip="{Binding State}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                    <TextBlock Style="{StaticResource Zweit}">
                                                        <Run Text="{Binding State, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Serial, Mode=OneWay}" FontFamily="{StaticResource Mono}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Position}" Style="{StaticResource Zahl}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Info}" Style="{StaticResource Zahl}" Foreground="{Binding InfoBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Mars: Zustand aus der Web-Schnittstelle (Port 7008) und die zwei Eingriffe -->
                    <StackPanel Margin="0,0,0,22">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Mars" Style="{StaticResource Gruppe}"/>
                            <TextBlock x:Name="MarsWebHinweis" Style="{StaticResource Zweit}" Margin="6,0,0,0" VerticalAlignment="Bottom" Text="lese Zustand …"/>
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource Linie}" BorderThickness="0,1,0,0">
                            <ItemsControl x:Name="MarsList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LinieFein}" BorderThickness="0,0,0,1" Height="34">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{Binding LampFill}" Stroke="{Binding LampStroke}" StrokeThickness="1.75" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Zahl}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <DockPanel Grid.Row="1">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Ereignisse" Style="{StaticResource Gruppe}"/>
                            <TextBlock x:Name="EreignisZahl" Text="0" Style="{StaticResource Zweit}" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource Linie}" BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock x:Name="EreignisLeer" Style="{StaticResource Zweit}" Margin="0,12,0,0" TextWrapping="Wrap"
                                           Text="Keine. Fehlende Bilder, Sprünge und Kartensprünge erscheinen hier mit Timecode."/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="EventList" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource LinieFein}" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle Width="10" Height="3" Fill="{DynamicResource Warn}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Tc}" Style="{StaticResource Zahl}" Foreground="{DynamicResource Text2}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Aufnahme -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Linie}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Take" Style="{StaticResource Zweit}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TakeBox" Text="Take_001" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Speicherort" Style="{StaticResource Zweit}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="Ordner wählen" Margin="8,0,0,0" Click="OnPickFolder"/>
                        <TextBox x:Name="FolderBox" FontFamily="{StaticResource Mono}" FontSize="12"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <TextBlock x:Name="TakeStatus" Text=" " Style="{StaticResource Zahl}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                    <Button x:Name="RecButton" Style="{StaticResource Haupt}" MinWidth="200" Click="OnRec">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="#FFFFFF" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="RecText" Text="Aufnahme starten" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statusleiste -->
        <Border Grid.Row="3" Background="{DynamicResource Flaeche}" BorderBrush="{DynamicResource Linie}" BorderThickness="0,1,0,0" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock x:Name="Version" DockPanel.Dock="Right" Style="{StaticResource Zahl}" Foreground="{DynamicResource Text2}" FontSize="11"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mars" Style="{StaticResource Zweit}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="IpBox" Width="120" Height="22" FontFamily="{StaticResource Mono}" FontSize="11" Background="{DynamicResource Grund}"/>
                    <Button x:Name="ReconnectButton" Content="Neu verbinden" Height="22" FontSize="12" Padding="8,0" Margin="6,0,0,0" Click="OnReconnect"/>
                    <TextBlock x:Name="PortText" Style="{StaticResource Zweit}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
